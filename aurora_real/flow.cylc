[scheduler]
    allow implicit tasks = False

[scheduling]
    initial cycle point = 20260406T0600Z
    cycling mode        = gregorian

    [[graph]]
        R1/^ = """
            download => inference => derive_precip => plot => plot_comparison => transfer
            inference => plot_wind => transfer
            derive_precip => plot_precip => transfer
        """
        R1/+PT6H = """
            download => inference => derive_precip => plot => plot_comparison => transfer
            inference => plot_wind => transfer
            derive_precip => plot_precip => transfer
            plot[-PT6H] => download
        """
        R1/+PT12H = """
            download => inference => derive_precip => plot => plot_comparison => transfer
            inference => plot_wind => transfer
            derive_precip => plot_precip => transfer
            plot[-PT6H] => download
        """
        R/+PT18H/PT6H = """
            plot[-PT6H] => wait_adaptive => download => inference => derive_precip => plot => plot_comparison => transfer
            inference => plot_wind => transfer
            derive_precip => plot_precip => transfer
        """

[runtime]
    [[root]]
        platform = aspire
        [[[environment]]]
            WORKFLOW_BASE_DIR = /data/projects/17001770/weather_department/nwp/wjang/aurora_real
        [[[directives]]]
            -P = 17001770
            -j = oe
            -q = normal

    [[download]]
        script = bash ${WORKFLOW_BASE_DIR}/bash/download.sh
        execution retry delays = 10*PT30M
        [[[directives]]]
            -l select=1:ncpus=1:mem=8gb
            -l walltime=08:00:00

    [[inference]]
        script = bash ${WORKFLOW_BASE_DIR}/bash/inference.sh
        execution retry delays = 10*PT30M
        [[[directives]]]
            -q = ai
            -l select=1:ncpus=1:ngpus=1:mem=64gb
            -l walltime=04:00:00

    [[derive_precip]]
        script = bash ${WORKFLOW_BASE_DIR}/bash/derive_precip.sh
        execution retry delays = 10*PT30M
        [[[directives]]]
            -l select=1:ncpus=1:mem=32gb
            -l walltime=01:00:00

    [[plot]]
        script = bash ${WORKFLOW_BASE_DIR}/bash/plot.sh
        execution retry delays = 10*PT30M
        [[[directives]]]
            -l select=1:ncpus=1:mem=32gb
            -l walltime=01:00:00

    [[plot_precip]]
        script = bash ${WORKFLOW_BASE_DIR}/bash/plot_precip.sh
        execution retry delays = 10*PT30M
        [[[directives]]]
            -l select=1:ncpus=1:mem=32gb
            -l walltime=01:00:00

    [[plot_wind]]
        script = bash ${WORKFLOW_BASE_DIR}/bash/plot_wind.sh
        execution retry delays = 10*PT30M
        [[[directives]]]
            -l select=1:ncpus=1:mem=32gb
            -l walltime=02:00:00

    [[plot_comparison]]
        script = bash ${WORKFLOW_BASE_DIR}/bash/plot_comparison.sh
        execution retry delays = 10*PT30M
        [[[directives]]]
            -l select=1:ncpus=1:mem=32gb
            -l walltime=01:00:00

    [[transfer]]
        script = bash ${WORKFLOW_BASE_DIR}/bash/transfer.sh
        execution retry delays = 10*PT30M
        [[[directives]]]
            -l select=1:ncpus=1:mem=4gb
            -l walltime=00:30:00

    [[wait_adaptive]]
        script = bash ${WORKFLOW_BASE_DIR}/bash/wait_adaptive.sh
        [[[directives]]]
            -l select=1:ncpus=1:mem=1gb
            -l walltime=10:00:00
